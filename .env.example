# ============================================================
#  anteiku — copy to .env, then edit.
#  ./setup.sh writes this file for you; editing by hand is fine too.
# ============================================================

# --- Identity -------------------------------------------------------
# Your user's IDs, so files the containers create belong to you.
# Find them with: id -u ; id -g
PUID=1000
PGID=1000

# Your timezone, e.g. Europe/Dublin. List: timedatectl list-timezones
TZ=Etc/UTC

# Group-write on finished files, so the *arrs can hardlink and move
# downloads. Leave at 002 unless you know why you're changing it.
UMASK=002

# --- Paths ----------------------------------------------------------
# Container configs. Small, read often — put this on your FASTEST disk.
# USE AN ABSOLUTE PATH. setup.sh writes one for you. A relative path is
# resolved differently by included compose files and your data ends up
# somewhere you did not intend, with no error.
APPDATA=/home/you/anteiku/appdata

# Media library root. Big — put this on your LARGEST disk.
#
# PATH CONTRACT: every service mounts this single root at /data.
# Downloads and library MUST live under it, on ONE filesystem, or
# hardlinks silently become full copies and your disk fills up twice.
MEDIA_ROOT=/home/you/anteiku/media

# --- Isolation ------------------------------------------------------
# Leave these alone unless you are running a SECOND copy alongside an
# existing stack (that is what the test config does).
COMPOSE_PROJECT_NAME=anteiku
DOCKER_NETWORK=anteiku
STACK_PREFIX=

# --- Ports ----------------------------------------------------------
# Change any that clash with something you already run.
PORT_PROWLARR=9696
PORT_BYPARR=8191
PORT_QBITTORRENT=8181
PORT_SONARR=8989
PORT_RADARR=7878
PORT_LIDARR=8686
PORT_LAZYLIBRARIAN=5299
PORT_BAZARR=6767
PORT_SEERR=5055
